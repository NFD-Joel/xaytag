---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Hero from '../components/Hero.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import PersonalSection from '../components/PersonalSection.astro';
import { projects } from '../data/projects';

const publicProjects = projects.filter((p) => !p.personal);
const year = new Date().getFullYear();
---

<Layout>
  <header class="topbar">
    <a class="logo" href="#top">xaytag</a>
    <nav class="nav">
      <a href="#work">Work</a>
      <a href="#personal">Personal</a>
    </nav>
    <ThemeToggle />
  </header>

  <span id="top"></span>
  <Hero />

  <main>
    <section class="work" id="work">
      <h2 class="section-title" data-reveal>Selected work</h2>
      <div class="grid">
        {publicProjects.map((project) => <Card project={project} />)}
      </div>
    </section>

    <PersonalSection />

    <footer class="foot">
      <span>© {year} xaytag</span>
      <span>xaytag.com</span>
    </footer>
  </main>
</Layout>

<!-- Inline classic script (is:inline) rather than a bundled module: a module
     that fails to execute (browser policy, extension, parse error) would leave
     every [data-reveal] element stuck at opacity:0 and the page blank. This
     runs defensively — any failure reveals everything, and a timeout is a
     final failsafe so content is never left hidden. -->
<script is:inline>
  (function () {
    var els = Array.prototype.slice.call(
      document.querySelectorAll('[data-reveal]')
    );
    function revealAll() {
      for (var i = 0; i < els.length; i++) els[i].classList.add('in');
    }

    // --- Scroll-reveal ---
    try {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                entries[i].target.classList.add('in');
                io.unobserve(entries[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
        // Failsafe: never leave content hidden if the observer misfires.
        setTimeout(revealAll, 3000);
      }
    } catch (e) {
      revealAll();
    }

    // --- Best-effort reachability probe (no-cors; not real monitoring) ---
    function setStatus(dot, state) {
      dot.dataset.status = state;
      var label = state === 'online' ? 'Online' : 'Unreachable';
      dot.title = label;
      dot.setAttribute('aria-label', label);
    }
    try {
      var cards = document.querySelectorAll('.card');
      Array.prototype.forEach.call(cards, function (card) {
        var url = card.dataset.url;
        var dot = card.querySelector('.dot');
        if (!url || !dot) return;
        var ctrl = new AbortController();
        var timer = setTimeout(function () {
          ctrl.abort();
        }, 6000);
        fetch(url, { mode: 'no-cors', signal: ctrl.signal })
          .then(function () {
            setStatus(dot, 'online');
          })
          .catch(function () {
            setStatus(dot, 'offline');
          })
          .finally(function () {
            clearTimeout(timer);
          });
      });
    } catch (e) {}
  })();
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 0.85rem clamp(1rem, 4vw, 2rem);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    flex: none;
  }

  .nav {
    display: flex;
    gap: 1.2rem;
    margin-left: auto;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .nav a {
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--text);
  }

  @media (max-width: 480px) {
    .nav {
      display: none;
    }
    .topbar {
      justify-content: space-between;
    }
  }

  main {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem) 2rem;
  }

  .work {
    scroll-margin-top: 70px;
    padding-top: 1rem;
  }

  .section-title {
    margin: 0 0 1.4rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.82rem;
  }
</style>
