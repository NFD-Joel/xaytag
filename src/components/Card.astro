---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, url, icon, logo, tag, tech, year, featured } =
  project;

// Open external links in a new tab; keep same-origin links in place.
const isExternal = /^https?:\/\//.test(url);
---

<a
  class:list={['card', { featured }]}
  href={url}
  data-url={url}
  data-reveal
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  <div class="top">
    {
      logo ? (
        <img class="logo" src={logo} alt={`${title} logo`} width="48" height="48" loading="lazy" />
      ) : (
        icon && <span class="icon" aria-hidden="true">{icon}</span>
      )
    }
    <span class="meta">
      {year && <span class="year">{year}</span>}
      <span
        class="dot"
        data-status="checking"
        title="Checking…"
        aria-label="Checking status"></span>
    </span>
  </div>

  {tag && <span class="tag">{tag}</span>}
  <h2 class="title">{title}</h2>
  <p class="desc">{description}</p>

  {
    tech && tech.length > 0 && (
      <ul class="tech">
        {tech.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }

  <span class="arrow" aria-hidden="true">↗</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.2rem 1.3rem 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* Gradient hairline that lights up on hover. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.18s ease;
    pointer-events: none;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    background: var(--bg-card-hover);
    border-color: var(--border-hover);
    box-shadow: 0 12px 34px var(--shadow);
    outline: none;
  }

  .card:hover::before,
  .card:focus-visible::before {
    opacity: 1;
  }

  .featured {
    padding: 1.5rem 1.6rem 1.7rem;
  }

  @media (min-width: 720px) {
    .featured {
      grid-column: span 2;
    }
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.6rem;
  }

  .icon {
    font-size: 1.7rem;
    line-height: 1;
  }
  .featured .icon {
    font-size: 2.1rem;
  }

  .logo {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: block;
    box-shadow: 0 2px 10px var(--shadow);
  }
  .featured .logo {
    width: 56px;
    height: 56px;
    border-radius: 14px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .year {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
    background: var(--warn);
  }

  .dot[data-status='checking'] {
    background: var(--warn);
    animation: pulse 1.1s ease-in-out infinite;
  }

  .dot[data-status='online'] {
    background: var(--ok);
    box-shadow: 0 0 8px var(--ok);
  }

  .dot[data-status='offline'] {
    background: var(--bad);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  .tag {
    align-self: flex-start;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    margin-top: 0.3rem;
  }

  .title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .featured .title {
    font-size: 1.55rem;
  }

  .desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .featured .desc {
    font-size: 0.98rem;
    max-width: 52ch;
  }

  .tech {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.7rem 0 0;
    padding: 0;
  }

  .tech li {
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.12rem 0.45rem;
  }

  .arrow {
    position: absolute;
    bottom: 1.1rem;
    right: 1.3rem;
    font-size: 1rem;
    color: var(--text-dim);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }

  .card:hover .arrow,
  .card:focus-visible .arrow {
    opacity: 0.8;
    transform: none;
    color: var(--accent);
  }
</style>
